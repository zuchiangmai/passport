{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "passport-auth",
  "account_id": "7bf23342f21baa5ebfc7bc7b74f5a1f2",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-25",
  "compatibility_flags": ["nodejs_compat"],
  "build": { "command": "node scripts/build-site-chrome.mjs", "watch_dir": "scripts" },
  "assets": { "directory": "./public" },
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "logs": { "invocation_logs": false }
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "passport-auth",
      "database_id": "6bb98778-c145-4517-9cda-87dd35f8afe9"
    }
  ],
  "vars": {
    "ENVIRONMENT": "development",
    "EMAIL_BACKEND": "resend",
    "BETTER_AUTH_URL": "https://4seas.xyz/passport",
    "MAIL_FROM": "4Seas Passport <no-reply@idoris.ai>"
  }
}
