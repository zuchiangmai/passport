# ---- Core ----
# sqlite (dev default) or postgresql+psycopg://user:pass@host:5432/cas
DATABASE_URL=sqlite:///./cas.db
JWT_SECRET=change-me-in-production
CHECKIN_SECRET=change-me-checkin-hmac-secret
# Bootstrap admin key for service-key management (POST/DELETE /v1/service-keys)
ADMIN_KEY=change-me-admin-key

# ---- Tokens ----
ACCESS_TOKEN_TTL_MINUTES=60
VERIFY_TOKEN_TTL_HOURS=24
LOGIN_TOKEN_TTL_MINUTES=15

# ---- Email ----
# console (dev) or smtp
EMAIL_BACKEND=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=no-reply@4seas.example

# ---- Public URL ----
# Login page and OAuth callbacks live under this origin + /passport.
PUBLIC_BASE_URL=https://4seas.xyz
COLIVING_CLIENT_SECRET=change-me-coliving
CANTEEN_CLIENT_SECRET=change-me-canteen
PASSCODE_TTL_MINUTES=10
AUTH_CODE_TTL_MINUTES=5

# Optional. Passkey is not required. Google and GitHub attach to the same sub by verified email.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---- Telegram ----
# Required to verify Mini App initData signatures. Leave empty in dev to use the
# dev-verify path (accepts any initData whose hash matches the empty token).
TELEGRAM_BOT_TOKEN=

# ---- Webhooks (CAS -> business systems) ----
WEBHOOK_TIMEOUT_SECONDS=5
WEBHOOK_MAX_ATTEMPTS=3
